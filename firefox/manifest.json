{
  "manifest_version": 3,
  "name": "WordPop 划词词典",
  "version": "0.1.0",
  "description": "选中英文即查词：离线柯林斯优先，查不到时用有道在线；支持在插件内置的 PDF 阅读器里查词。",
  "browser_specific_settings": {
    "gecko": {
      "id": "wordpop@s2982359.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "core/lookup.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core/lookup.js",
        "core/render.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdfjs/web/viewer.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "WordPop：打开 PDF 阅读器"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
